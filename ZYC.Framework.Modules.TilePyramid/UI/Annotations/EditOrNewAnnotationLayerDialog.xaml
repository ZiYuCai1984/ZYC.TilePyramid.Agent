<zyc:DialogWindowBase x:Class="ZYC.Framework.Modules.TilePyramid.UI.Annotations.EditOrNewAnnotationLayerDialog"
                      x:ClassModifier="internal"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:zyc="https://github.com/ZiYuCai1984"
                      xmlns:wpf="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
                      mc:Ignorable="d"
                      Width="380"
                      SizeToContent="Height"
                      ResizeMode="NoResize"
                      ShowInTaskbar="False"
                      d:DesignHeight="450" 
                      d:DesignWidth="800"
                      Title="{zyc:LBinding EditOrNewAnnotationLayerRequest.Title}"
                      DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <zyc:DialogWindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ZYC.Framework.Modules.TilePyramid;component/Resources/Styles/Common.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type zyc:HybridIcon}"
                   BasedOn="{StaticResource HybridIcon16Style}">
            </Style>
        </ResourceDictionary>
    </zyc:DialogWindowBase.Resources>
    <StackPanel Margin="16 0">
        <TextBlock Text="{zyc:L Name}"
                   Margin="0 8 0 0" />
        <!--!WARNING Emoji.Wpf.TextBox's internal binding still uses LostFocus despite PropertyChanged here.
            OnPreviewKeyDown explicitly updates that binding before confirming with Enter. -->
        <wpf:TextBox x:Name="LayerNameInput"
                     Margin="0 8 0 0" 
                     Text="{Binding EditOrNewAnnotationLayerRequest.LayerName, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,16">

            <zyc:IconButton IsDefault="True"
                            MinWidth="80"
                            Kind="Check"
                            Text="{zyc:L Confirm}"
                            Margin="0,0,8,0"
                            Click="Confirm_OnClick" />
            <zyc:IconButton Text="{zyc:L Cancel}"
                            Kind="Close"
                            MinWidth="80"
                            Click="Cancel_OnClick" />
        </StackPanel>
    </StackPanel>

</zyc:DialogWindowBase>
