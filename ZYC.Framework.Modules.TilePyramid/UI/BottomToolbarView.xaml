<UserControl x:Class="ZYC.Framework.Modules.TilePyramid.UI.BottomToolbarView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:zyc="https://github.com/ZiYuCai1984"
             xmlns:ui="clr-namespace:ZYC.Framework.Modules.TilePyramid.UI"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=ui:TilePyramidDocumentView}">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary
                        Source="/ZYC.Framework.Modules.TilePyramid;component/Resources/Styles/Common.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <Style TargetType="{x:Type zyc:HybridIcon}"
                       BasedOn="{StaticResource HybridIcon16Style}" />

                <Style TargetType="{x:Type iconPacks:PackIconMaterial}"
                       BasedOn="{StaticResource PackIconMaterial16Style}" />

            </ResourceDictionary>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal">
            <ItemsControl ItemsSource="{Binding ZoomPresets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}"
                                ContentStringFormat="{}{0:G4}×"
                                Command="{Binding DataContext.ZoomPresetCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                CommandParameter="{Binding .}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Command="{Binding FitToSourceCommand}">
                <iconPacks:PackIconMaterial Kind="FitToScreenOutline" />
            </Button>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Command="{Binding CenterOnCommand}">
                <iconPacks:PackIconMaterial Kind="ImageFilterCenterFocusStrongOutline" />
            </Button>
            <Button Command="{Binding ZoomCommand}">
                <Button.CommandParameter>
                    <sys:Double>0.5</sys:Double>
                </Button.CommandParameter>
                <iconPacks:PackIconMaterial Kind="Minus" />
            </Button>

            <TextBlock Text="{Binding ZoomFactor, StringFormat={}{0:0.#}×}"
                       FontWeight="SemiBold"
                       MinWidth="42"
                       TextAlignment="Center"
                       VerticalAlignment="Center" />
            <Button Command="{Binding ZoomCommand}">
                <Button.CommandParameter>
                    <sys:Double>2</sys:Double>
                </Button.CommandParameter>
                <iconPacks:PackIconMaterial Kind="Plus" />
            </Button>

            <Border Width="1"
                    Margin="8 0"
                    Height="18"
                    Background="{StaticResource MahApps.Brushes.Gray8}" />

            <Button Command="{Binding RotateCommand}">
                <Button.CommandParameter>
                    <sys:Double>-15</sys:Double>
                </Button.CommandParameter>
                <iconPacks:PackIconMaterial Kind="FileRotateLeftOutline" />
            </Button>
            <TextBlock Text="{Binding RotationDegrees, StringFormat={}{0:0.#}°}"
                       FontWeight="SemiBold"
                       MinWidth="42"
                       TextAlignment="Center"
                       VerticalAlignment="Center" />
            <Button Command="{Binding RotateCommand}">
                <Button.CommandParameter>
                    <sys:Double>15</sys:Double>
                </Button.CommandParameter>
                <iconPacks:PackIconMaterial Kind="FileRotateRightOutline" />
            </Button>
            <Button Command="{Binding ResetRotationCommand}">
                <iconPacks:PackIconMaterial Kind="Rotate3dVariant" />
            </Button>

        </StackPanel>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    IsEnabled="{Binding HasMultipleFocalPlanes}">
            <TextBlock ToolTip="{Binding FocalPlaneToolTip}"
                       ToolTipService.ShowOnDisabled="True"
                       Margin="0 0 8 0"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center">
                <Run Text="{zyc:L Focal Plane}" />
                <Run Text=" : " />
                <Run Text="{Binding FocalPlaneNumber, Mode=OneWay}" />
                <Run Text="/" />
                <Run Text="{Binding FocalPlaneCount, Mode=OneWay}" />
            </TextBlock>

            <Button Command="{Binding MinusFocalPlaneIndexCommand}">
                <iconPacks:PackIconMaterial Kind="VectorDifference" />
            </Button>
            <Slider Minimum="0"
                    Width="128"
                    Maximum="{Binding MaximumFocalPlaneIndex}"
                    Value="{Binding FocalPlaneIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SmallChange="1"
                    LargeChange="1"
                    IsSnapToTickEnabled="True"
                    IsMoveToPointEnabled="True"
                    VerticalAlignment="Center"
                    ToolTip="{zyc:L Switch Focal Plane}" />
            <Button Command="{Binding AddFocalPlaneIndexCommand}">
                <iconPacks:PackIconMaterial Kind="VectorIntersection" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>