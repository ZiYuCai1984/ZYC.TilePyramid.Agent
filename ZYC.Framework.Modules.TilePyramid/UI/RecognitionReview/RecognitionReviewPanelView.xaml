<UserControl x:Class="ZYC.Framework.Modules.TilePyramid.UI.RecognitionReview.RecognitionReviewPanelView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:zyc="https://github.com/ZiYuCai1984"
             xmlns:annotations="clr-namespace:ZYC.Framework.Modules.TilePyramid.UI.Annotations"
             xmlns:converters="clr-namespace:ZYC.Framework.Modules.TilePyramid.Converters"
             xmlns:bindings="clr-namespace:ZYC.Framework.Core.Bindings;assembly=ZYC.Framework.Core"
             xmlns:ui="clr-namespace:ZYC.Framework.Modules.TilePyramid.UI"
             xmlns:wpf="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:recognitionReview="clr-namespace:ZYC.Framework.Modules.TilePyramid.UI.RecognitionReview"
             mc:Ignorable="d"
             Background="White"
             Padding="8"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=ui:TilePyramidDocumentView}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="/ZYC.Framework.Modules.TilePyramid;component/Resources/Styles/Common.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <bindings:BindingProxy x:Key="PanelContext" Data="{Binding}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel Margin="8 0 0 0">
            <UniformGrid Columns="3"
                         Margin="0 8 0 8">


                <RadioButton IsChecked="{Binding IsCandidatesMode, Mode=TwoWay}"
                             HorizontalAlignment="Left"
                             HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ClipboardClockOutline"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="2 0  4 0" />
                        <TextBlock>
                            <Run Text="{zyc:L Pending}" />
                            <Run Text="{Binding PendingReviewCount, Mode=OneWay, StringFormat='({0})'}" />
                        </TextBlock>
                    </StackPanel>

                </RadioButton>


                <RadioButton IsChecked="{Binding IsAcceptedMode, Mode=TwoWay}"
                             HorizontalAlignment="Left"
                             HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FileDocumentCheckOutline"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="2 0  4 0" />

                        <TextBlock>
                            <Run Text="{zyc:L Accepted}" />
                            <Run Text="{Binding AcceptedReviewCount, Mode=OneWay, StringFormat='({0})'}" />
                        </TextBlock>
                    </StackPanel>

                </RadioButton>
                <RadioButton IsChecked="{Binding IsRejectedMode, Mode=TwoWay}"
                             HorizontalAlignment="Left"
                             HorizontalContentAlignment="Center">

                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="TrashCanOutline"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0 0  4 0" />
                        <TextBlock>
                            <Run Text="{zyc:L Rejected}" />
                            <Run Text="{Binding RejectedReviewCount, Mode=OneWay, StringFormat='({0})'}" />
                        </TextBlock>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>


            <Grid Margin="0 4 0 8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontWeight="SemiBold"
                    Margin="2 0 8 0"
                    VerticalAlignment="Center">
                    <Run Text="{zyc:L Recognition batch}" />
                    <Run Text=":" />
                </TextBlock>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding RecognitionBatches}"
                          SelectedItem="{Binding SelectedRecognitionBatch, Mode=TwoWay}"
                          IsSynchronizedWithCurrentItem="False">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text">
                                            <Setter.Value>
                                                <MultiBinding StringFormat="{}{0} · {1:MM-dd HH:mm} · {2:N}">
                                                    <Binding Path="Batch.Model" />
                                                    <Binding Path="Batch.StartedAt.LocalDateTime" />
                                                    <Binding Path="Batch.Id" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Batch}" Value="{x:Null}">
                                                <Setter Property="Text" Value="{zyc:L All batches}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>


        </StackPanel>

        <!-- Virtualized pixel scrolling keeps expanded recognition details reachable. -->
        <ListView
            Grid.Row="1"
            x:Name="RecognitionList"
            ItemsSource="{Binding RecognitionListView}"
            ui:ListItemNavigation.Request="{Binding RecognitionNavigationRequest}"
            Padding="0"
            ScrollViewer.CanContentScroll="True"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid d:DataContext="{d:DesignInstance Type=recognitionReview:RecognitionReviewItem}">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            Margin="4 0 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <annotations:AnnotationThumbnailView Height="96"
                                                                 Width="96"
                                                                 VerticalAlignment="Top"
                                                                 Cursor="Hand"
                                                                 AspectRatio="1"
                                                                 MouseLeftButtonDown="AnnotationItem_OnMouseLeftButtonDown"
                                                                 Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type ui:TilePyramidDocumentView}}}"
                                                                 Shape="{Binding Feature.Shape}"
                                                                 FocalPlaneIndex="{Binding Batch.FocalPlaneIndex}"
                                                                 Stroke="{Binding Feature.StrokeArgb, Converter={converters:AnnotationColorConverter}}"
                                                                 Source="{Binding AnnotationSource, RelativeSource={RelativeSource AncestorType={x:Type ui:TilePyramidDocumentView}}}" />
                            <Grid Grid.Column="1"
                                  Margin="8 0 0 0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <zyc:HybridIcon Icon="{Binding Feature.Icon}"
                                                    Foreground="{Binding Feature.StrokeArgb, Converter={converters:AnnotationColorConverter}}"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0 0 6 0"
                                                    VerticalAlignment="Top" />

                                    <wpf:TextBlock Grid.Column="1"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Top">
                                        <wpf:TextBlock.Style>
                                            <Style TargetType="wpf:TextBlock">
                                                <Setter Property="Text" Value="{Binding Feature.Label}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Feature.Label}" Value="">
                                                        <Setter Property="Text"
                                                                Value="{zyc:L (Untitled Annotation)}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Feature.Label}" Value="{x:Null}">
                                                        <Setter Property="Text"
                                                                Value="{zyc:L (Untitled Annotation)}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </wpf:TextBlock.Style>
                                    </wpf:TextBlock>


                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Feature.Score}"
                                                   FontWeight="SemiBold"
                                                   Margin="6 0" />

                                        <!--Foreground="{StaticResource MahApps.Brushes.SystemControlErrorTextForeground}"-->
                                        <Button
                                            VerticalAlignment="Top"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding Data.NavigateToAnnotationCommand, Source={StaticResource PanelContext}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding Annotation,Converter={zyc:NullToBoolConverter}}">
                                            <iconPacks:PackIconMaterial Kind="LinkVariant"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Width="16"
                                                                        Height="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>


                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>

                                    <TextBlock TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Layer.Name}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Layer}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="{Binding Feature.LayerId}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Layer.Name}" Value="">
                                                        <Setter Property="Text" Value="{Binding Feature.LayerId}" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Feature.LayerId}" Value="" />
                                                            <Condition Binding="{Binding Layer.Name}" Value="" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Text" Value="{zyc:L Default Layer}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Row="1"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="128"
                                               Text="{Binding Feature.Comments}" />

                                </Grid>


                            </Grid>
                        </Grid>

                        <Expander Grid.Row="1"
                                  Margin="0 8 0 0"
                                  Style="{StaticResource RecognitionDetailsExpanderStyle}">
                            <Expander.Header>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{zyc:L Details}"
                                        VerticalAlignment="Top"
                                        Margin="2 6 0 0" />


                                    <StackPanel Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                        <zyc:IconButton
                                            Text="{zyc:L Accept}"
                                            Kind="Check"
                                            Visibility="{Binding ShowAcceptAction, Converter={zyc:BoolToVisibilityConverter}}"
                                            Command="{Binding Data.AcceptRecognitionCommand, Source={StaticResource PanelContext}}"
                                            CommandParameter="{Binding}" />

                                        <zyc:IconButton Margin="8 0 0 0"
                                                        Text="{zyc:L Reject}"
                                                        Kind="CircleOffOutline"
                                                        Visibility="{Binding ShowRejectAction, Converter={zyc:BoolToVisibilityConverter}}"
                                                        Command="{Binding Data.RejectRecognitionCommand, Source={StaticResource PanelContext}}"
                                                        CommandParameter="{Binding}" />
                                        <zyc:IconButton Margin="8 0 0 0"
                                                        Text="{zyc:L Create annotation}"
                                                        Kind="TagPlusOutline"
                                                        Visibility="{Binding ShowCreateAnnotationAction, Converter={zyc:BoolToVisibilityConverter}}"
                                                        Command="{Binding Data.CreateRecognitionAnnotationCommand, Source={StaticResource PanelContext}}"
                                                        CommandParameter="{Binding}" />
                                        <zyc:IconButton Margin="8 0 0 0"
                                                        Kind="Refresh"
                                                        Text="{zyc:L Return to pending}"
                                                        Visibility="{Binding ShowResetAction, Converter={zyc:BoolToVisibilityConverter}}"
                                                        Command="{Binding Data.ResetRecognitionReviewCommand, Source={StaticResource PanelContext}}"
                                                        CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>


                            </Expander.Header>
                            <Expander.Content>
                                <Grid>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="Margin" Value="0 2 0 2" />
                                        </Style>
                                        <Style x:Key="DetailLabel" TargetType="TextBlock"
                                               BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Opacity" Value="0.65" />
                                            <Setter Property="Margin" Value="0 2 12 2" />
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MaxWidth="120" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Text="{zyc:L Model}"
                                               Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding Batch.Model}" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Text="{zyc:L Batch}"
                                               Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Text="{Binding Batch.Id}" />
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="0"
                                               Text="{zyc:L Feature}"
                                               Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="1"
                                               Text="{Binding Feature.Id}" />
                                    <TextBlock Grid.Column="0"
                                               Grid.Row="4"
                                               Text="{zyc:L Original bounds}"
                                               Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Row="4"
                                               Grid.Column="1">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:G6}, {1:G6}, {2:G6} × {3:G6}">
                                                <Binding Path="Feature.Bounds.X" />
                                                <Binding Path="Feature.Bounds.Y" />
                                                <Binding Path="Feature.Bounds.Width" />
                                                <Binding Path="Feature.Bounds.Height" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Grid.Row="5"
                                               Grid.Column="0"
                                               Text="{zyc:L Focal Plane}"
                                               Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Row="5"
                                               Grid.Column="1"
                                               Text="{Binding FocalPlaneNumber}" />
                                    <TextBlock Grid.Row="6"
                                               Grid.Column="0"
                                               Text="{zyc:L Started}"
                                               Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Row="6"
                                               Grid.Column="1"
                                               Text="{Binding Batch.StartedAt.LocalDateTime, StringFormat=g}" />
                                    <TextBlock Grid.Row="7"
                                               Grid.Column="0"
                                               Text="{zyc:L Submissions ended}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DetailLabel}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Batch.IsOpen}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Row="7" Grid.Column="1">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Text"
                                                        Value="{Binding Batch.EndedAt.LocalDateTime, StringFormat=g, FallbackValue=''}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Batch.IsOpen}" Value="True">
                                                        <Setter Property="Text" Value="{zyc:L Receiving results}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Row="8"
                                               Grid.Column="0"
                                               Text="{zyc:L Annotation}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DetailLabel}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Feature.AnnotationId}"
                                                                 Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Row="8"
                                               Grid.Column="1"
                                               Text="{Binding Feature.AnnotationId}" />
                                </Grid>
                            </Expander.Content>
                        </Expander>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="1"
                   Text="{zyc:L No matching recognition results}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="12"
                   TextWrapping="Wrap"
                   Opacity="0.75"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RecognitionListView.IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
