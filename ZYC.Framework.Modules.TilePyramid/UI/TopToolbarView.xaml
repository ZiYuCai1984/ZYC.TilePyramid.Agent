<UserControl x:Class="ZYC.Framework.Modules.TilePyramid.UI.TopToolbarView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:editing="clr-namespace:ZYC.TilePyramid.Annotations.Wpf.Editing;assembly=ZYC.TilePyramid.Annotations.Wpf"
             xmlns:zyc="https://github.com/ZiYuCai1984"
             xmlns:commands="clr-namespace:ZYC.Framework.Modules.TilePyramid.Commands"
             xmlns:ui="clr-namespace:ZYC.Framework.Modules.TilePyramid.UI"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=ui:TilePyramidDocumentView}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="/ZYC.Framework.Modules.TilePyramid;component/Resources/Styles/Common.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type zyc:HybridIcon}"
                   BasedOn="{StaticResource HybridIcon16Style}" />

            <Style TargetType="{x:Type iconPacks:PackIconMaterial}"
                   BasedOn="{StaticResource PackIconMaterial16Style}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Background="{StaticResource ToolbarBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                IsEnabled="{Binding IsViewInitialized}"
                Margin="8 0 0 0">
                <iconPacks:PackIconMaterial Kind="EyeOutline"
                                            Margin="0 0 8 0" />
                <TextBlock Margin="0 0 8 0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold">
                    <Run Text="{zyc:L View}" />
                    <Run Text=":" />
                </TextBlock>

                <Button Command="{zyc:LifetimeScopeResolve {x:Type commands:ToggleMinimapCommand}}"
                        CommandParameter="{Binding DocumentState}">
                    <iconPacks:PackIconMaterial Kind="MapOutline" />
                </Button>


                <Button Command="{zyc:LifetimeScopeResolve {x:Type commands:ToggleDocumentInfoCommand}}"
                        CommandParameter="{Binding DocumentState}">
                    <iconPacks:PackIconMaterial Kind="InformationOutline" />
                </Button>


                <Button Command="{zyc:LifetimeScopeResolve {x:Type commands:ToggleAnnotationsPanelCommand}}"
                        CommandParameter="{Binding DocumentState}">
                    <iconPacks:PackIconMaterial Kind="TagOutline" />
                </Button>

                <Button Command="{zyc:LifetimeScopeResolve {x:Type commands:ToggleDebugPanelCommand}}"
                        CommandParameter="{Binding DocumentState}"
                        Visibility="{Binding TilePyramidConfig.DebugMode,RelativeSource={RelativeSource AncestorType=ui:TopToolbarView},Converter={zyc:BoolToVisibilityConverter}}">
                    <iconPacks:PackIconMaterial Kind="BugOutline" />
                </Button>

                <Button Command="{zyc:LifetimeScopeResolve {x:Type commands:ToggleRecognitionPanelCommand}}"
                        CommandParameter="{Binding DocumentState}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ClipboardClockOutline" />
                        <TextBlock Text="{Binding PendingRecognitionCount}"
                                   Margin="4 0 0 0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>


            </StackPanel>


            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        IsEnabled="{Binding IsViewInitialized}">

                <iconPacks:PackIconMaterial Kind="LayersOutline"
                                            Margin="0 0 8 0" />

                <TextBlock Margin="0 0 8 0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold">
                    <Run Text="{zyc:L Annotation Layer}" />
                    <Run Text=":" />
                </TextBlock>
                <ComboBox ItemsSource="{Binding AnnotationLayers}"
                          SelectedItem="{Binding SelectedAnnotationLayer, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          IsSynchronizedWithCurrentItem="False"
                          VerticalAlignment="Center"
                          Width="256"
                          ToolTip="{zyc:LBinding AnnotationLayerHint}"
                          Margin="0 0 8 0" />

                <Button Command="{Binding NewAnnotationLayerDialogCommand}"
                        IsEnabled="{Binding CanStartAnnotationEdit}">
                    <iconPacks:PackIconMaterial Kind="Plus" />
                </Button>
                <Border Width="1"
                        Margin="8 0"
                        Height="18"
                        Background="{StaticResource MahApps.Brushes.Gray8}" />

                <iconPacks:PackIconMaterial Kind="SelectDrag"
                                            Margin="0 0 8 0" />

                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0 0 8 0">
                    <Run Text="{zyc:L Annotation Tools}" />
                    <Run Text=" :" />
                </TextBlock>

                <Button Command="{Binding AnnotationToolCommand}"
                        CommandParameter="{x:Static editing:AnnotationTool.Rectangle}">
                    <iconPacks:PackIconMaterial Kind="VectorRectangle" />
                </Button>

                <Button Command="{Binding AnnotationToolCommand}"
                        CommandParameter="{x:Static editing:AnnotationTool.Ellipse}">
                    <iconPacks:PackIconMaterial Kind="VectorEllipse" />
                </Button>
                <Button Command="{Binding AnnotationToolCommand}"
                        CommandParameter="{x:Static editing:AnnotationTool.Polygon}">
                    <iconPacks:PackIconMaterial Kind="VectorPolygon" />
                </Button>

            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <iconPacks:PackIconMaterial Kind="HeadSnowflakeOutline"
                                            Margin="0 0 8 0" />

                <TextBlock Margin="0 0 8 0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold">
                    <Run Text="{zyc:L AI Agent}" />
                    <Run Text=":" />
                </TextBlock>

                <Button Command="{zyc:LifetimeScopeResolve commands:ToggleAgentTasksPanelCommand}"
                        CommandParameter="{Binding DocumentState}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="ClipboardPulseOutline"
                                                    Margin="0 0 8 0" />
                        <TextBlock Text="{Binding AgentTasksStatusText}"
                                   VerticalAlignment="Center"
                                   MaxWidth="180"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>


        <!--//TODO-zyc Why not just use `Resolve` here ??-->
        <ContentControl Grid.Row="1"
                        HorizontalContentAlignment="Stretch"
                        Content="{Binding AgentTasksPanel}"
                        Visibility="{Binding  DocumentState.IsAgentTasksPanelOpened, Converter={zyc:BoolToVisibilityConverter}}" />
    </Grid>
</UserControl>